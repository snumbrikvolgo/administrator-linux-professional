set default=0
set timeout=1

insmod net
insmod efinet
insmod tftp
insmod linux

menuentry "Install Debian stable netinst ISO (preseed)" {
    linux (tftp,{{ pxe_server_ip }})/debian/vmlinuz auto=true priority=critical preseed/url=http://{{ pxe_server_ip }}/srv/ks/preseed.cfg url=http://{{ pxe_server_ip }}/srv/ks/preseed.cfg interface=auto netcfg/choose_interface=auto BOOTIF=01-${net_default_mac} initrd=debian/initrd.gz
    initrd (tftp,{{ pxe_server_ip }})/debian/initrd.gz
}
