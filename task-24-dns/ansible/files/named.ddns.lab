$TTL 3600
$ORIGIN ddns.lab.
@       IN SOA  ns01.dns.lab. root.dns.lab. (
        2026072201 ; serial
        3600       ; refresh
        600        ; retry
        86400      ; expire
        600        ; minimum
)
        IN NS   ns01.dns.lab.
        IN NS   ns02.dns.lab.

ns01    IN A    192.168.90.10
ns02    IN A    192.168.90.11
