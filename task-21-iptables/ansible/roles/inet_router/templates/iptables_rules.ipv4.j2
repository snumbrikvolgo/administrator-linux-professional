*filter
:INPUT DROP [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A INPUT -p icmp -j ACCEPT
-A INPUT -i eth0 -p tcp --dport 22 -j ACCEPT
-A INPUT -s 192.168.60.0/24 -p tcp --dport 22 -j ACCEPT
-A INPUT -i eth1 -p tcp --dport 7000 -m recent --name SSH1 --set -j DROP
-A INPUT -i eth1 -p tcp --dport 8000 -m recent --name SSH1 --rcheck --seconds 15 -m recent --name SSH2 --set -j DROP
-A INPUT -i eth1 -p tcp --dport 9000 -m recent --name SSH2 --rcheck --seconds 15 -m recent --name SSHOPEN --set -j DROP
-A INPUT -i eth1 -p tcp -s 192.168.255.2 --dport 22 -m recent --name SSHOPEN --rcheck --seconds 60 -j ACCEPT
-A INPUT -i eth1 -p tcp --dport 22 -j DROP
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
-A POSTROUTING ! -d 192.168.0.0/16 -o eth0 -j MASQUERADE
COMMIT
