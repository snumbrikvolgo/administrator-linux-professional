groups:
  - name: cms
    rules:
      - alert: InstanceDown
        expr: up{job="node"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "{{ '{{ $labels.instance }}' }} is unreachable"

      - alert: BackendDown
        expr: probe_success{job="backend"} == 0
        for: 30s
        labels:
          severity: critical
        annotations:
          summary: "CMS backend {{ '{{ $labels.instance }}' }} is down"

      - alert: CmsDown
        expr: probe_success{job="cms"} == 0
        for: 30s
        labels:
          severity: critical
        annotations:
          summary: "CMS is not answering on {{ '{{ $labels.instance }}' }}"

      - alert: HighDiskUsage
        expr: 100 - (node_filesystem_avail_bytes{fstype!~"tmpfs|ramfs"} / node_filesystem_size_bytes * 100) > 85
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Disk {{ '{{ $labels.mountpoint }}' }} on {{ '{{ $labels.instance }}' }} is above 85%"
