log_format cms '$remote_addr - $remote_user [$time_local] '
               '"$request" $status $body_bytes_sent '
               '"$http_referer" "$http_user_agent"';

upstream cms_backend {
{% for host in backend_hosts %}
    server {{ host }}:{{ backend_port }} max_fails=2 fail_timeout=5s;
{% endfor %}
}

server {
    listen 80;
    server_name _;
    access_log /var/log/nginx/cms_access.log cms;
    return 301 https://$host:{{ external_https_port }}$request_uri;
}

server {
    listen 443 ssl;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

{% if letsencrypt_enabled %}
    ssl_certificate /etc/letsencrypt/live/{{ cms_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ cms_domain }}/privkey.pem;
{% else %}
    ssl_certificate /etc/nginx/tls/cms.crt;
    ssl_certificate_key /etc/nginx/tls/cms.key;
{% endif %}

    access_log /var/log/nginx/cms_access.log cms;
    error_log /var/log/nginx/cms_error.log;

    location /api/ {
        proxy_pass http://cms_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Retry on the other backend when one app node is down.
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_connect_timeout 2s;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
